# =============================================================================
# WiseUp API - variaveis de ambiente para o Railway
# =============================================================================
# Como usar:
#   Railway > servico be-wiseup > Variables > "Raw Editor" > colar este bloco
#   (remova os comentarios se o editor reclamar) > Deploy.
#
# ATENCAO - antes de colar, revise:
#   1. "Postgres" nas referencias abaixo deve ser o NOME EXATO do servico
#      PostgreSQL dentro deste mesmo projeto Railway. Se ele se chamar
#      "postgres" ou "wiseup-db", troque em DATABASE_URL/USER/PASSWORD.
#   2. CORS_ORIGINS esta em localhost:5173 (front ainda nao publicado).
#      Acrescente a URL de producao do be-wiseup-one quando existir.
#   3. SEED_USERS: a senha NAO fica neste arquivo. Preencha o valor direto
#      no painel do Railway (Variables), no formato email:senha.
# =============================================================================

# --- HTTP -------------------------------------------------------------------
# O Quarkus le PORT; o Railway expoe o servico nessa porta.
PORT=8080

# --- Banco de dados ---------------------------------------------------------
# O Railway fornece DATABASE_URL no formato "postgresql://...", que o JDBC do
# Quarkus NAO aceita. Por isso montamos a URL jdbc: a partir das variaveis
# individuais do servico Postgres (rede privada interna do projeto).
DATABASE_URL=jdbc:postgresql://${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
DATABASE_USER=${{Postgres.PGUSER}}
DATABASE_PASSWORD=${{Postgres.PGPASSWORD}}

# --- CORS -------------------------------------------------------------------
# Lista separada por virgula, sem barra no final.
CORS_ORIGINS=http://localhost:5173

# --- Provedor de midia upstream ---------------------------------------------
UPSTREAM_BASE_URL=https://www.pornhub.com/webmasters
EMBED_BASE_URL=https://www.pornhub.com/embed
UPSTREAM_TIMEOUT_MS=8000

# --- Cache em memoria -------------------------------------------------------
CACHE_TTL_SECONDS=600
CACHE_MAX_ENTRIES=500
CACHE_MAX_STALE_SECONDS=3600

# --- Sessao e protecao contra brute force -----------------------------------
SESSION_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Usuario inicial (criado no boot) ---------------------------------------
# Formato: email:senha,email:senha
# Para virar admin, rode depois no banco:
#   UPDATE users SET is_admin = true WHERE email = '<seu-email>';
SEED_USERS=matheusfaria77@hotmail.com:DEFINA_A_SENHA_NO_PAINEL

# --- reCAPTCHA v2 (vazio = desativado) --------------------------------------
RECAPTCHA_SECRET=

# --- Versoes dos documentos legais ------------------------------------------
LEGAL_VERSION_TERMOS=2026-11-05
LEGAL_VERSION_PRIVACIDADE=2026-11-05

# --- Retencao de logs de acesso (Marco Civil art.15) ------------------------
ACCESS_LOG_RETENTION_DAYS=180

# --- Job de sincronizacao com a origem --------------------------------------
SYNC_INTERVAL_HOURS=6
SYNC_PAGES=2

# --- JVM --------------------------------------------------------------------
# Ajuste MaxRAMPercentage se o plano do Railway tiver pouca memoria.
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=70.0 -XX:+UseG1GC -Dfile.encoding=UTF-8
