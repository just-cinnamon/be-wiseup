# =============================================================================
# WiseUp Backend – Environment Variables Template
# =============================================================================

# --- Server & Networking ---
PORT=8080
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL) ---
# Format: jdbc:postgresql://<host>:<port>/<dbname>[?sslmode=require]
DATABASE_URL=jdbc:postgresql://localhost:5432/wiseup
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# --- Authentication & Security ---
# Secret for Google reCAPTCHA v2. Leave blank in dev/test to disable.
RECAPTCHA_SECRET=
# Initial users created on first boot: email:password,email2:password2
SEED_USERS=ana@wiseup.test:segredo123
SESSION_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- External Upstream Media Provider ---
UPSTREAM_BASE_URL=https://www.pornhub.com/webmasters
EMBED_BASE_URL=https://www.pornhub.com/embed
UPSTREAM_TIMEOUT_MS=8000

# --- Cache & Performance ---
CACHE_TTL_SECONDS=600
CACHE_MAX_ENTRIES=500
CACHE_MAX_STALE_SECONDS=3600

# --- Legal Compliance & Policy Versions ---
# Changing these dates forces all logged users to re-accept documents before catalogue access
LEGAL_VERSION_TERMOS=2026-11-05
LEGAL_VERSION_PRIVACIDADE=2026-11-05
# Marco Civil da Internet (art. 15) access log retention in days
ACCESS_LOG_RETENTION_DAYS=180

# --- Background Schedulers ---
SYNC_INTERVAL_HOURS=6
SYNC_PAGES=2
